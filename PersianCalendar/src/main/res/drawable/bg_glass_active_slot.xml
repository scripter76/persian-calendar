<?xml version="1.0" encoding="utf-8"?>
<!-- کپسول انتخاب وقت فعال — شیشه‌ای با درخشش بنفش iOS -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- حاشیه‌ی درخشان بنفش/اسطوخودوسی -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#80E2D5FF"
                android:centerColor="#40A77DF0"
                android:endColor="#257038D0" />
        </shape>
    </item>
    <!-- بدنه‌ی کپسول شیشه‌ای بنفش -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#508B5CF6"
                android:centerColor="#3D7C3AED"
                android:endColor="#486D28D9" />
        </shape>
    </item>
</layer-list>
