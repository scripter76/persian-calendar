<?xml version="1.0" encoding="utf-8"?>
<!-- نوار پایینی شیشه‌ای مایع (Liquid Glass Bottom Bar) با حاشیه نورانی و بدنه فوق‌شفاف -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#90FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#15FFFFFF" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
