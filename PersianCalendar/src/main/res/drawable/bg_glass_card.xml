<?xml version="1.0" encoding="utf-8"?>
<!--
  کارت شیشه‌ای ساعت — سبک شیشه مایع iOS با ته‌مایه بنفش.
  حاشیه‌ی بیرونی گرادیانی بسیار ظریف + بدنه‌ی شیشه‌ای نیمه‌شفاف
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="16dp"
                android:bottomLeftRadius="16dp"
                android:topRightRadius="28dp"
                android:bottomRightRadius="28dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#4AE8DCFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#228A6ECE" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="15dp"
                android:bottomLeftRadius="15dp"
                android:topRightRadius="27dp"
                android:bottomRightRadius="27dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#332B1854"
                android:centerColor="#241B0E3D"
                android:endColor="#38190B38" />
        </shape>
    </item>

</layer-list>
