<?xml version="1.0" encoding="utf-8"?>
<!-- کارت ساعت شیشه‌ای مایع (Liquid Glass) با حاشیه نورانی انکساری و بدنه فوق‌شفاف -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- حاشیه بازتاب نور انکساری شیشه (Specular Rim) -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="16dp"
                android:bottomLeftRadius="16dp"
                android:topRightRadius="28dp"
                android:bottomRightRadius="28dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#90FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#15FFFFFF" />
        </shape>
    </item>

    <!-- بدنه‌ی شیشه‌ای فوق‌شفاف متناسب با والپیپرهای تیره و معتدل -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="15dp"
                android:bottomLeftRadius="15dp"
                android:topRightRadius="27dp"
                android:bottomRightRadius="27dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
