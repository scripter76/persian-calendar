<?xml version="1.0" encoding="utf-8"?>
<!-- کارت شیشه‌ای تقویم — سبک شیشه iOS با ته‌مایه بنفش -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#4AE8DCFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#228A6ECE" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#332B1854"
                android:centerColor="#241B0E3D"
                android:endColor="#38190B38" />
        </shape>
    </item>
</layer-list>
