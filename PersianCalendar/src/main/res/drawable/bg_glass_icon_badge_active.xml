<?xml version="1.0" encoding="utf-8"?>
<!-- نشان وقت فعال — بنفش درخشان کریستالی سبک iOS -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#99F0E8FF"
                android:endColor="#458B5CF6" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#669333EA"
                android:endColor="#486D28D9" />
        </shape>
    </item>
</layer-list>
