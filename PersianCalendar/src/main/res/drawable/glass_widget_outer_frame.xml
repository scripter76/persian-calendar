<?xml version="1.0" encoding="utf-8"?>
<!-- خط موی بیرونی ویجت: سبک لبه‌های شیشه‌ای شفاف با هاله بنفش ملایم -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#4AE5DAFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#20987EE0" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
