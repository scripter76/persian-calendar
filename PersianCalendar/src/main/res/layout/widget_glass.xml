<?xml version="1.0" encoding="utf-8"?>
<!--
  ویجت اوقات شرعی — نسخه‌ی شیشه‌ای، ۴×۲ (۳۴۰×۱۴۰dp)
  شناسه‌ها با فایل قبلی یکی است، پس کد پرکننده‌ی ویجت تغییری لازم ندارد
  (جز دو شناسه‌ی تازه: glass_scrim و glass_clock_ampm).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout_glass"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@drawable/bg_widget_clip"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_root_click_ripple_effect">

    <!-- ۱. پس‌زمینه. برای نسخه‌ی وکتوری: android:src="@drawable/bg_glass_night" -->
    <ImageView
        android:id="@+id/widget_glass_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_glass_mosque"
        android:importantForAccessibility="no" />

    <!-- ۲. تیرگی ملایم برای کنتراست متن -->
    <ImageView
        android:id="@+id/glass_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glass_scrim"
        android:importantForAccessibility="no" />

    <!-- ۳. خط موی بیرونی -->
    <ImageView
        android:id="@+id/widget_glass_outer_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glass_widget_outer_frame"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- ================= ردیف بالا ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- ستون راست: تاریخ کامل، سپس تقویم + شمارش معکوس -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/glass_full_date_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- کارت تقویم (راست‌ترین) -->
                    <LinearLayout
                        android:id="@+id/glass_calendar_card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card_sm"
                        android:gravity="center"
                        android:minWidth="40dp"
                        android:orientation="vertical"
                        android:paddingStart="6dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:id="@+id/glass_calendar_icon"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_glass_calendar" />

                        <ImageView
                            android:id="@+id/glass_calendar_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:adjustViewBounds="true"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/glass_calendar_month"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:adjustViewBounds="true"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/glass_calendar_year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:adjustViewBounds="true"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/glass_divider"
        android:importantForAccessibility="no" />

                    <!-- شمارش معکوس تا وقت بعدی -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/glass_sparkle_icon"
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:layout_marginEnd="4dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_glass_sparkle" />

                            <ImageView
                                android:id="@+id/glass_countdown_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:adjustViewBounds="true"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/glass_horizon_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:layout_marginStart="15dp"
                            android:adjustViewBounds="true"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- کارت ساعت (چپ‌ترین) — قاب دفرمه -->
            <LinearLayout
                android:id="@+id/glass_clock_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:gravity="end"
                android:minWidth="118dp"
                android:orientation="vertical"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="7dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/glass_location_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/glass_location_icon"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glass_location" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layoutDirection="ltr"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextClock
                        android:id="@+id/glass_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/glass_time"
                        android:textSize="33sp"
                        android:textStyle="bold"
                        android:textLocale="en" />

                    <TextClock
                        android:id="@+id/glass_clock_ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_marginBottom="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/glass_time_ampm"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textLocale="en" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/glass_clock_underline"
                    android:layout_width="26dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/glass_accent_underline"
        android:importantForAccessibility="no" />
            </LinearLayout>

        </LinearLayout>

        <!-- ================= نوار اوقات ================= -->
        <LinearLayout
            android:id="@+id/glass_bottom_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_glass_bottom_bar"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="5dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <!-- RTL: ۱=صبح تا ۶=نیمه‌شب -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 1. صبح -->
                <LinearLayout
                    android:id="@+id/glass_slot_fajr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/glass_icon_fajr"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:background="@drawable/bg_glass_icon_badge"
                        android:padding="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glass_fajr" />

                    <ImageView
                        android:id="@+id/glass_title_fajr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/glass_val_fajr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <ImageView
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="@drawable/glass_divider"
        android:importantForAccessibility="no" />

                <!-- 2. طلوع -->
                <LinearLayout
                    android:id="@+id/glass_slot_sunrise"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/glass_icon_sunrise"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:background="@drawable/bg_glass_icon_badge"
                        android:padding="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glass_sunrise" />

                    <ImageView
                        android:id="@+id/glass_title_sunrise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/glass_val_sunrise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <ImageView
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="@drawable/glass_divider"
        android:importantForAccessibility="no" />

                <!-- 3. ظهر -->
                <LinearLayout
                    android:id="@+id/glass_slot_dhuhr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/glass_icon_dhuhr"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:background="@drawable/bg_glass_icon_badge"
                        android:padding="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glass_dhuhr" />

                    <ImageView
                        android:id="@+id/glass_title_dhuhr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/glass_val_dhuhr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <ImageView
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="@drawable/glass_divider"
        android:importantForAccessibility="no" />

                <!-- 4. غروب -->
                <LinearLayout
                    android:id="@+id/glass_slot_sunset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/glass_icon_sunset"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:background="@drawable/bg_glass_icon_badge"
                        android:padding="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glass_sunset" />

                    <ImageView
                        android:id="@+id/glass_title_sunset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/glass_val_sunset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <ImageView
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="@drawable/glass_divider"
        android:importantForAccessibility="no" />

                <!-- 5. مغرب -->
                <LinearLayout
                    android:id="@+id/glass_slot_maghrib"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/glass_icon_maghrib"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:background="@drawable/bg_glass_icon_badge"
                        android:padding="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glass_maghrib" />

                    <ImageView
                        android:id="@+id/glass_title_maghrib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/glass_val_maghrib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <ImageView
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="@drawable/glass_divider"
        android:importantForAccessibility="no" />

                <!-- 6. نیمه‌شب -->
                <LinearLayout
                    android:id="@+id/glass_slot_midnight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/glass_icon_midnight"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:background="@drawable/bg_glass_icon_badge"
                        android:padding="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glass_midnight" />

                    <ImageView
                        android:id="@+id/glass_title_midnight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/glass_val_midnight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no" />
                </LinearLayout>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/glass_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="14dp"
                android:indeterminate="false"
                android:max="1000"
                android:progress="620"
                android:progressDrawable="@drawable/glass_progress_bar" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
