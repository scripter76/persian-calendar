<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="com.byagowi.persiancalendar.ui.settings.widgetnotification.WidgetGlassConfigurationActivity"
    android:description="@string/widget_glass_description"
    android:initialLayout="@layout/widget_glass"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="70dp"
    android:previewImage="@drawable/bg_glass_mosque"
    android:previewLayout="@layout/widget_glass"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="600000"
    android:widgetCategory="keyguard|home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional"
    tools:ignore="UnusedAttribute" />
